# ==============================================================================
# CONFIGURATION PRODUCTION EDGS MANAGER
# Renommez ce fichier en '.env' sur votre serveur de production.
# ==============================================================================

# 1. Base de données PostgreSQL
DB_NAME=edgs
DB_USER=edgs_user
DB_PASSWORD=choisissez_un_mot_de_passe_tres_secu_ici
DB_CONTAINER_NAME=edgs_db_prod

# 2. Sécurité de l'API Backend
JWT_SECRET=generer_une_cle_jwt_aleatoire_et_longue_ici
JWT_EXPIRES_IN=24h

# 3. Stockage S3 (AWS S3)
# Pour AWS, l'endpoint ressemble à : s3.eu-west-3.amazonaws.com (si région Paris)
S3_ENDPOINT=s3.eu-west-3.amazonaws.com
S3_ACCESS_KEY=VOTRE_AWS_ACCESS_KEY_ICI
S3_SECRET_KEY=VOTRE_AWS_SECRET_KEY_ICI
S3_BUCKET=edgs-production-bucket
AWS_REGION=eu-west-3

# 4. Noms de domaine (Caddy)
# Renseignez vos noms de domaine configurés (Assurez-vous que vos DNS pointent vers l'IP du VPS AWS)
DOMAIN_NAME_ADMIN=admin.votredomaine.com
DOMAIN_NAME_API=api.votredomaine.com
