# Configuration Caddy pour EDGS Manager
# Caddy gère automatiquement l'obtention et le renouvellement des certificats SSL (HTTPS) avec Let's Encrypt.

# Sous-domaine d'administration (ex: admin.edgs.fr)
{$DOMAIN_NAME_ADMIN} {
    reverse_proxy backoffice:80
    
    # Sécurité basique
    encode gzip
    header {
        # Protéger contre le clickjacking
        X-Frame-Options "DENY"
        # Prévenir le reniflage de type MIME
        X-Content-Type-Options "nosniff"
        # Activer le filtre XSS
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "no-referrer-when-downgrade"
    }
}

# Sous-domaine de l'API REST (ex: api.edgs.fr)
{$DOMAIN_NAME_API} {
    reverse_proxy api:3000
    
    # Sécurité basique
    encode gzip
    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
        Access-Control-Allow-Headers "Content-Type, Authorization"
        X-Content-Type-Options "nosniff"
    }
}
